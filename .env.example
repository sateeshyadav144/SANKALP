# ==============================================================================
# SANKALP — Smart Campus Ecosystem Environment Variables (Safe Template)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Client-Side Public Configuration (VITE_ prefix is bundled into browser)
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key-here

# Application Environment Mode: 'production' | 'development'
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# 2. Server-Side Private Secrets (DO NOT prefix with VITE_ to prevent client bundling)
# ------------------------------------------------------------------------------
# For production deployment with Supabase Edge Functions (gemini-proxy):
# Run in terminal: supabase secrets set GEMINI_API_KEY=AIzaSy...
# Or set in your hosting platform's server environment variables:
GEMINI_API_KEY=your-private-gemini-api-key-here
